---
import { env } from "cloudflare:workers";
import Base from "../../layouts/Base.astro";
import { messageHeaders } from "../../lib/http";
import { countdownSegments, formatUtcShort, lockedEarlierText, messageMeta, timerHtml } from "../../lib/message-view";
import { getMessage, type StoredMessage } from "../../lib/messages";
import { formatUtc } from "../../lib/time";

export const prerender = false;

const id = Astro.params.id ?? "";
const now = Date.now();
let message: StoredMessage | null = null;
let failed = false;
if (env.DB) {
	try {
		message = await getMessage(env.DB, id);
	} catch (err) {
		console.error("failed to load message", err);
		failed = true;
	}
} else {
	failed = true;
}
// A derived id can also find a message hosted earlier under a random id. Its page stays at the address it was shared with.
if (message && message.id !== id) return Astro.redirect(`/m/${message.id}`, 302);
if (!message) Astro.response.status = failed ? 503 : 404;
// Also set by the middleware. Repeated here so this page can never be cached or leak its address as a referrer.
for (const [k, v] of Object.entries(messageHeaders("/m/") ?? {})) Astro.response.headers.set(k, v);

const unlocked = message !== null && message.unlockAt <= now;
const meta = message
	? messageMeta(message, now)
	: { title: "Message not found · timelock.dev", description: "There is no message at this link." };
const iso = (ms: number) => new Date(ms).toISOString();
---

<Base title={meta.title} description={meta.description} noindex={!message}>
	<div class="container narrow message-page">
		{
			message ? (
				<div
					data-message
					data-id={message.id}
					data-unlock-at={message.unlockAt}
					data-server-now={now}
					data-state={unlocked ? "opening" : "locked"}
				>
					<section class="stage" aria-label={unlocked ? "Unlocked message" : "Locked message"}>
						<div data-locked hidden={unlocked}>
							<h1 class="stage-title">This message opens in</h1>
							<div class="timer" data-timer role="timer" set:html={timerHtml(countdownSegments((message.unlockAt - now) / 1000))} />
							<p class="stage-when">
								<time data-local datetime={iso(message.unlockAt)}>{formatUtcShort(message.unlockAt)}</time>
							</p>
						</div>

						<div data-open hidden={!unlocked}>
							<h1 class="stage-title">The message</h1>
							<div class="reveal" data-reveal hidden>
								<pre data-plaintext data-size="lg" />
							</div>
							<p class="stage-status" data-status aria-live="polite">Decrypting in your browser…</p>
							<noscript>
								<p class="stage-status">Turn on JavaScript to decrypt here, or open the encrypted text below with any tlock tool.</p>
							</noscript>
							<p class="stage-when is-small">
								Unlocked <time data-local datetime={iso(message.unlockAt)}>{formatUtcShort(message.unlockAt)}</time>
							</p>
							<p class="stage-meta">
								{lockedEarlierText(message.createdAt, message.unlockAt)} <time data-local datetime={iso(message.createdAt)}>{formatUtcShort(message.createdAt)}</time>
							</p>
						</div>

						<div class="stage-actions">
							<button class="btn big" type="button" data-copy-link>Copy link</button>
							<button class="btn big secondary" type="button" data-share hidden>Share</button>
							<button class="btn big secondary" type="button" data-copy-message hidden>Copy message</button>
							<button class="btn big secondary" type="button" data-download-message hidden>Download file</button>
						</div>
					</section>

					<p class="stage-note" data-locked-note hidden={unlocked}>
						Nobody can open it early, not even the sender. <a href="/how-it-works">How it works</a>
					</p>

					<details class="proof">
						<summary>Proof and encrypted text</summary>
						<div class="proof-body">
							<dl class="proof-facts">
								<dt>Locked</dt>
								<dd>
									<time data-local datetime={iso(message.createdAt)}>{formatUtcShort(message.createdAt)}</time>
									<span class="muted">{formatUtc(message.createdAt)}</span>
								</dd>
								<dt>{unlocked ? "Opened" : "Opens"}</dt>
								<dd>
									<time data-local datetime={iso(message.unlockAt)}>{formatUtcShort(message.unlockAt)}</time>
									<span class="muted">{formatUtc(message.unlockAt)}</span>
								</dd>
								<dt>Key</dt>
								<dd>drand quicknet round #{message.round.toLocaleString("en-US")}</dd>
								<dt>SHA-256</dt>
								<dd>
									<code>{message.sha256}</code>
								</dd>
							</dl>
							<label for="message-ciphertext">Encrypted text</label>
							<textarea id="message-ciphertext" class="code" rows="6" readonly spellcheck="false" data-ciphertext set:text={message.ciphertext} />
							<div class="row proof-actions">
								<button class="btn secondary" type="button" data-copy-cipher>Copy encrypted text</button>
								<button class="btn secondary" type="button" data-download-cipher>Download .age file</button>
							</div>
							<p class="hint">
								“Locked” is when our server received the encrypted text. It has not changed since: the SHA-256 above is the hash of the downloaded
								file. To prove the date without trusting us, post that hash somewhere public today. We store the encrypted text, never the message,
								and it also opens with <a href="/how-it-works#offline">other tlock tools</a> after the unlock time.
							</p>
						</div>
					</details>

					<p class="message-cta">
						<a href="/">Lock your own message</a>
					</p>
				</div>
			) : (
				<section class="stage">
					<h1 class="stage-title is-large">{failed ? "This message can't be loaded right now." : "There is no message at this link."}</h1>
					<p class="stage-when is-small">{failed ? "Try again in a moment." : "Check that you have the whole link."}</p>
					<div class="stage-actions">
						<a class="btn big" href="/">Lock your own message</a>
					</div>
				</section>
			)
		}
	</div>
</Base>

<script>
	import { startMessagePage } from "../../scripts/message";

	const root = document.querySelector<HTMLElement>("[data-message]");
	if (root) startMessagePage(root);
</script>
