---
import { env } from "cloudflare:workers";
import Activity from "../components/Activity.astro";
import EncryptForm from "../components/EncryptForm.astro";
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
import { ACTIVITY_PREVIEW } from "../lib/activity";
import { loadActivity } from "../lib/activity-data";

export const prerender = false;

const now = Date.now();
const activity = await loadActivity(env.DB, ACTIVITY_PREVIEW, now);
Astro.response.headers.set("Cache-Control", "no-cache");
const description =
	"Lock a message until a time you pick and share it as a link with a live countdown. It is encrypted in your browser with drand timelock encryption, so nobody can read it early. Free, no account.";
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "WebApplication",
	name: "timelock.dev",
	url: "https://timelock.dev/",
	description,
	applicationCategory: "SecurityApplication",
	operatingSystem: "Any",
	browserRequirements: "Requires JavaScript",
	isAccessibleForFree: true,
	offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<Base title="timelock.dev: lock a message until a future time" description={description} jsonLd={jsonLd}>
	{/* Decrypt used to be a section of this page. Old links to it go to its own page. */}
	<script is:inline>
		if (location.hash === "#decrypt") location.replace("/decrypt");
	</script>
	<section class="hero">
		<div class="container narrow">
			<h1>Send a message <span class="accent">into the future</span></h1>
			<p class="lead">Write a message, pick a time and share the link. Nobody can read it before then, not even you or us.</p>
		</div>
	</section>

	<div class="container narrow">
		<EncryptForm />
		<p class="after-card">Have an encrypted message? <a href="/decrypt">Decrypt it</a></p>
		<ul class="assurances">
			<li><Icon name="lock" /><span>Encrypted in your browser</span></li>
			<li><Icon name="shield" /><span>We never see your message</span></li>
			<li><Icon name="check" /><span>No account, no cookies</span></li>
		</ul>
		<Activity data={activity} now={now} limit={ACTIVITY_PREVIEW} />
	</div>
</Base>
