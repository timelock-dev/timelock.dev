<section id="decrypt" class="Box card" aria-label="Decrypt a message">
	<form id="decrypt-form" novalidate>
		<div class="field">
			<label for="decrypt-input">Encrypted message</label>
			<textarea id="decrypt-input" class="code" rows="8" required spellcheck="false" placeholder="-----BEGIN AGE ENCRYPTED FILE-----&#10;…&#10;-----END AGE ENCRYPTED FILE-----"></textarea>
		</div>
		<div data-lock-panel aria-live="polite" hidden></div>
		<p class="status" data-status hidden aria-live="polite"></p>
		<button class="btn big block" type="submit">Decrypt</button>
	</form>

	<div data-output hidden>
		<h2 class="result-title">Message</h2>
		<pre data-plaintext tabindex="0"></pre>
		<div class="row">
			<button class="btn big" type="button" data-copy>Copy</button>
			<button class="btn big" type="button" data-download hidden>Download file</button>
			<button class="btn big secondary" type="button" data-again>Decrypt another</button>
		</div>
	</div>
</section>

<style>
	.result-title {
		margin: 0 0 12px;
		font-size: 16px;
	}
	pre[data-plaintext] {
		padding: 16px 20px;
		border: 1px solid var(--mint-border);
		border-radius: var(--radius-lg);
		background: var(--mint);
		font-family: var(--sans);
		font-size: 17px;
		line-height: 1.5;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
</style>

<script>
	import { createDrandClient, DrandUnavailableError } from "../lib/drand";
	import { decrypt, extractArmor, inspectCiphertext, InvalidCiphertextError, TooEarlyError, UnsupportedChainError, type CiphertextInfo } from "../lib/tlock";
	import { decryptStatePanelHtml } from "../lib/status";
	import { findMessagePage } from "../scripts/find-page";
	import { shareLinkId, takeHandOff } from "../scripts/handoff";
	import { reportEventOnce } from "../scripts/report";

	const section = document.querySelector<HTMLElement>("#decrypt")!;
	const $ = <T extends HTMLElement>(sel: string) => section.querySelector<T>(sel)!;
	const form = $<HTMLFormElement>("#decrypt-form");
	const input = $<HTMLTextAreaElement>("#decrypt-input");
	const status = $("[data-status]");
	const output = $("[data-output]");
	const client = createDrandClient();
	let info: CiphertextInfo | null = null;
	let plaintext: Uint8Array | null = null;

	const lockPanel = $("[data-lock-panel]");
	let panelHtml = "";
	/** The pasted text last checked for a hosted page, and that check. */
	let looked = { text: "", page: Promise.resolve<string | null>(null) };

	/** A hosted message has its own page with the countdown and the message, so pasted text that matches one goes there. */
	function lookForPage(text: string) {
		if (text === looked.text) return;
		const page = findMessagePage(text);
		looked = { text, page };
		void page.then((path) => {
			if (path && !form.hidden && input.value.trim() === text) location.assign(path);
		});
	}

	function show(kind: "" | "ok" | "err", text: string) {
		status.className = `status ${kind}`.trim();
		status.textContent = text;
		status.hidden = !text;
		if (text) hidePanel();
	}

	function hidePanel() {
		lockPanel.hidden = true;
		panelHtml = "";
	}

	function renderInfo() {
		if (!info) return;
		const html = decryptStatePanelHtml(info.unlockAt, Date.now(), info.notes);
		if (html !== panelHtml) lockPanel.innerHTML = panelHtml = html;
		lockPanel.hidden = false;
		status.hidden = true;
	}

	function inspect() {
		const text = input.value.trim();
		info = null;
		hidePanel();
		if (!text) return show("", "");
		// A pasted share link goes to its page, which counts down or decrypts by itself.
		const id = shareLinkId(text);
		if (id) {
			location.assign(`/m/${id}`);
			return;
		}
		try {
			info = inspectCiphertext(text);
			renderInfo();
			lookForPage(text);
		} catch (err) {
			show("err", err instanceof Error ? err.message : String(err));
		}
	}

	input.addEventListener("input", inspect);
	const handedOff = takeHandOff();
	if (handedOff) {
		input.value = handedOff;
		inspect();
	}

	form.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (!input.value.trim()) return show("err", "Paste an encrypted message first.");
		const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
		button.disabled = true;
		button.textContent = "Decrypting…";
		try {
			const pasted = input.value;
			if (looked.text === pasted.trim() && (await looked.page)) return;
			const result = await decrypt(pasted, client);
			plaintext = result.plaintext;
			let text: string | null = null;
			try {
				text = new TextDecoder("utf-8", { fatal: true }).decode(plaintext);
			} catch {
				text = null;
			}
			$("[data-plaintext]").textContent = text ?? `This is a file, not text (${plaintext.byteLength.toLocaleString("en-US")} bytes). Use “Download file”.`;
			$("[data-copy]").hidden = text === null;
			$("[data-download]").hidden = text !== null;
			show("", "");
			form.hidden = true;
			output.hidden = false;
			void reportEventOnce("decrypt", result.info.round, extractArmor(pasted)?.block ?? pasted.trim());
		} catch (err) {
			if (err instanceof TooEarlyError) renderInfo();
			else if (err instanceof DrandUnavailableError) show("err", "Could not reach drand to get the key for this round. Try again in a moment.");
			else if (err instanceof InvalidCiphertextError || err instanceof UnsupportedChainError) show("err", err.message);
			else show("err", `Decryption failed: ${err instanceof Error ? err.message : String(err)}`);
		} finally {
			button.disabled = false;
			button.textContent = "Decrypt";
		}
	});

	$("[data-copy]").addEventListener("click", async (e) => {
		await navigator.clipboard.writeText($("[data-plaintext]").textContent ?? "");
		const b = e.currentTarget as HTMLButtonElement;
		b.textContent = "Copied";
		setTimeout(() => (b.textContent = "Copy"), 1500);
	});
	$("[data-download]").addEventListener("click", () => {
		if (!plaintext) return;
		const a = document.createElement("a");
		a.href = URL.createObjectURL(new Blob([plaintext as BlobPart]));
		a.download = "timelock-decrypted.bin";
		a.click();
		URL.revokeObjectURL(a.href);
	});
	$("[data-again]").addEventListener("click", () => {
		output.hidden = true;
		form.hidden = false;
		plaintext = null;
		input.value = "";
		inspect();
		input.focus();
	});

	setInterval(() => {
		if (info && !form.hidden && !status.classList.contains("err")) renderInfo();
	}, 1000);
</script>
