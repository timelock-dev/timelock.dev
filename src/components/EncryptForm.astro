---
import Icon from "./Icon.astro";
import { DURATION_UNITS } from "../lib/unlock";

const presets: [amount: number, unit: string, label: string][] = [
	[5, "minutes", "5 min"],
	[1, "hours", "1 hour"],
	[1, "days", "1 day"],
	[7, "days", "1 week"],
	[30, "days", "30 days"],
	[365, "days", "1 year"],
];
---

<section id="encrypt" class="Box card" aria-labelledby="encrypt-title">
	<h2 class="sr-only" id="encrypt-title">Encrypt a message</h2>
	<form id="encrypt-form" novalidate>
		<div class="field">
			<label for="message">Message</label>
			<textarea id="message" name="message" rows="4" required placeholder="Write a message to read later."></textarea>
			<p class="status err message-error" data-message-error role="alert" hidden>Write a message to encrypt.</p>
		</div>

		<fieldset class="field">
			<legend>When can it be opened?</legend>
			<div class="chips" role="group" aria-label="Unlock time">
				{
					presets.map(([amount, unit, label]) => (
						<button type="button" class="chip" data-amount={amount} data-unit={unit} aria-pressed={amount === 5 && unit === "minutes" ? "true" : "false"}>
							{label}
						</button>
					))
				}
				<button type="button" class="chip" data-choice="custom" aria-pressed="false" aria-controls="panel-duration">Custom</button>
				<button type="button" class="chip" data-choice="date" aria-pressed="false" aria-controls="panel-date">Pick a date</button>
			</div>

			<div id="panel-duration" class="panel duration-inputs" hidden>
				<label for="amount" class="sr-only">Amount</label>
				<input type="number" id="amount" name="amount" value="5" min="1" step="1" inputmode="decimal" />
				<label for="unit" class="sr-only">Unit</label>
				<select id="unit" name="unit">
					{DURATION_UNITS.map((u) => <option value={u.value} selected={u.value === "minutes"}>{u.label}</option>)}
				</select>
			</div>

			<div id="panel-date" class="panel date-picker" hidden>
				<div class="calendar" data-calendar>
					<div class="calendar-head">
						<button type="button" class="icon-btn" data-prev aria-label="Previous month">‹</button>
						<span class="calendar-title" data-month-title aria-live="polite"></span>
						<button type="button" class="icon-btn" data-next aria-label="Next month">›</button>
					</div>
					<table class="calendar-grid" role="grid">
						<thead><tr>{["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"].map((d) => <th scope="col">{d}</th>)}</tr></thead>
						<tbody data-days></tbody>
					</table>
				</div>
				<div class="date-fields">
					<div>
						<label for="unlock-time">Time</label>
						<input type="time" id="unlock-time" name="unlock-time" value="09:00" step="60" />
					</div>
					<div>
						<label for="time-zone">Time zone</label>
						<select id="time-zone" name="time-zone"></select>
					</div>
				</div>
			</div>
		</fieldset>

		<p class="unlock-line" data-feedback>
			<Icon name="clock" />
			<span>Opens <strong data-local>—</strong><span class="muted" data-duration></span></span>
		</p>
		<p class="status err" data-error role="alert" hidden></p>

		<button class="btn big block" type="submit">Encrypt</button>
	</form>

	<div data-result hidden>
		<div data-share-result hidden>
			<h3 class="result-title"><Icon name="lock" /><span>Locked. Share this link.</span></h3>
			<p class="result-when" data-share-when></p>
			<div class="share-link-row">
				<input type="text" data-share-url readonly aria-label="Share link" />
				<button class="btn big" type="button" data-copy-link>Copy link</button>
			</div>
		</div>
		<div data-result-status></div>
		<p class="status err" data-host-error role="alert" hidden></p>

		<p class="result-links">
			<a data-open-link href="/">Open the page</a>
			<button class="link-btn" type="button" data-share-link hidden>Share</button>
			<button class="link-btn" type="button" data-again>Encrypt another</button>
		</p>

		<details class="cipher-details" data-cipher-details>
			<summary>Encrypted text</summary>
			<textarea id="ciphertext" class="code" rows="9" readonly spellcheck="false" aria-label="Encrypted text"></textarea>
			<p class="notes-option">
				<label class="check"><input type="checkbox" data-notes checked /> Include unlock notes</label>
				<a href="/faq#notes">About notes</a>
			</p>
			<div class="row">
				<button class="btn" type="button" data-copy>Copy</button>
				<button class="btn secondary" type="button" data-download>Download .age file</button>
				<button class="btn secondary" type="button" data-to-decrypt>Open in Decrypt</button>
			</div>
		</details>
	</div>
</section>

<style>
	.panel {
		margin-top: 12px;
	}
	.duration-inputs {
		display: flex;
		gap: 8px;
	}
	.duration-inputs input {
		width: 120px;
	}
	.duration-inputs select {
		width: auto;
		min-width: 120px;
	}
	.date-picker {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		align-items: flex-start;
	}
	.calendar {
		width: 264px;
		max-width: 100%;
		padding: 8px;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
	}
	.calendar-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 4px;
	}
	.calendar-title {
		font-weight: 600;
	}
	.icon-btn {
		width: 28px;
		height: 28px;
		border: 0;
		border-radius: var(--radius);
		background: transparent;
		font-size: 18px;
		line-height: 1;
		color: var(--muted);
		cursor: pointer;
	}
	.icon-btn:hover:not(:disabled) {
		background: var(--canvas-subtle);
		color: var(--text);
	}
	.icon-btn:disabled {
		opacity: 0.35;
		cursor: not-allowed;
	}
	.calendar-grid {
		width: 100%;
		margin: 0;
		table-layout: fixed;
	}
	.date-fields {
		display: grid;
		gap: 16px;
		flex: 1;
		min-width: 200px;
	}
	.unlock-line {
		display: flex;
		align-items: flex-start;
		gap: 8px;
		margin: 0 0 20px;
		font-size: 15px;
	}
	.unlock-line .octicon {
		margin-top: 3px;
		color: var(--green);
	}
	.message-error {
		margin: 8px 0 0;
	}
	.result-title {
		display: flex;
		align-items: center;
		gap: 10px;
		margin: 0 0 4px;
		font-size: 22px;
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	.result-title .octicon {
		width: 20px;
		height: 20px;
		color: var(--green);
	}
	.result-when {
		margin: 0 0 16px;
		font-size: 16px;
		color: var(--muted);
	}
	.share-link-row {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 16px;
	}
	.share-link-row input {
		flex: 1 1 260px;
		width: auto;
		height: 48px;
		border-radius: 12px;
		font: 15px/1 var(--mono);
		text-overflow: ellipsis;
	}
	.share-link-row .btn {
		flex: 1 1 140px;
	}
	.result-links {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
		margin: 0;
		font-weight: 500;
	}
	.link-btn {
		padding: 0;
		border: 0;
		background: none;
		font: inherit;
		color: var(--link);
		cursor: pointer;
	}
	.link-btn:hover {
		text-decoration: underline;
	}
	.cipher-details {
		margin-top: 20px;
		padding-top: 16px;
		border-top: 1px solid var(--border-muted);
	}
	.cipher-details > summary {
		font-weight: 500;
		color: var(--muted);
		cursor: pointer;
	}
	.cipher-details textarea {
		margin-top: 12px;
	}
	.notes-option {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 4px 16px;
		margin: 8px 0 12px;
	}
	.check {
		display: flex;
		align-items: center;
		gap: 8px;
		margin: 0;
		font-weight: 400;
		cursor: pointer;
	}
	.check input {
		width: 16px;
		height: 16px;
		margin: 0;
		accent-color: var(--green);
	}
</style>
<style is:global>
	.calendar-grid tr,
	.calendar-grid tbody tr:nth-child(2n) {
		background: none;
	}
	.calendar-grid th,
	.calendar-grid td {
		padding: 1px;
		border: 0;
		text-align: center;
	}
	.calendar-grid th {
		font-size: 12px;
		font-weight: 400;
		color: var(--muted);
		padding-bottom: 4px;
	}
	.calendar-grid button {
		width: 100%;
		height: 32px;
		border: 1px solid transparent;
		border-radius: var(--radius);
		background: transparent;
		font-size: 12px;
		font-variant-numeric: tabular-nums;
		cursor: pointer;
	}
	.calendar-grid button:hover:not(:disabled) {
		background: var(--canvas-subtle);
		border-color: var(--border);
	}
	.calendar-grid button:disabled {
		color: #8c959f;
		text-decoration: line-through;
		text-decoration-color: #d1d9e0;
		cursor: not-allowed;
	}
	.calendar-grid button.is-today {
		font-weight: 600;
		border-color: var(--border);
	}
	.calendar-grid button[aria-pressed="true"] {
		background: var(--link);
		border-color: var(--link);
		color: #ffffff;
		font-weight: 600;
	}
</style>

<script>
	import { createDrandClient, roundForTime, roundTime } from "../lib/drand";
	import { encrypt } from "../lib/tlock";
	import { encryptedPanelHtml } from "../lib/status";
	import { noteLines, withNotes } from "../lib/notes";
	import { detectTimeZone, formatFriendly, formatSpan, zonedParts } from "../lib/time";
	import { addMonths, compareDays, dateTarget, durationTarget, MAX_LOCK_SECONDS, monthGrid, todayIn, timeZoneList, type Day, type Target } from "../lib/unlock";
	import { handOffToDecrypt } from "../scripts/handoff";
	import { EVENT_REPORTED, reportEventOnce } from "../scripts/report";

	const form = document.querySelector<HTMLFormElement>("#encrypt-form")!;
	const section = document.querySelector<HTMLElement>("#encrypt")!;
	const $ = <T extends HTMLElement>(sel: string) => section.querySelector<T>(sel)!;
	const amountInput = $<HTMLInputElement>("#amount");
	const unitSelect = section.querySelector("#unit") as unknown as HTMLSelectElement;
	const timeInput = $<HTMLInputElement>("#unlock-time");
	const zoneSelect = section.querySelector("#time-zone") as unknown as HTMLSelectElement;
	const daysBody = $("[data-days]");
	const errorBox = $("[data-error]");
	const feedback = $("[data-feedback]");
	const result = $("[data-result]");
	const client = createDrandClient();
	const browserZone = detectTimeZone();

	/** Which chip is on: a preset duration, a custom duration, or a date and time. */
	let choice: "preset" | "custom" | "date" = "preset";
	let lockedUntil = 0;
	let resultHtml = "";
	let armored = "";
	let shareUrl = "";
	let submitError = "";

	/** Uploads the encrypted block (never the message) and returns its link. */
	async function createLink(block: string): Promise<string> {
		const res = await fetch("/api/messages", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ ciphertext: block }) });
		const body = (await res.json().catch(() => null)) as { url?: string; error?: { message?: string } } | null;
		if (!res.ok || !body?.url) throw new Error(body?.error?.message ?? `The server answered ${res.status}.`);
		return body.url;
	}
	let noteZone = browserZone;
	let zone = browserZone;
	let selected: Day | null = null;
	let view = { year: 0, month: 0 };

	zoneSelect.replaceChildren(
		...timeZoneList(browserZone).map((z) => new Option(z === browserZone ? `${z.replace(/_/g, " ")} (detected)` : z.replace(/_/g, " "), z, z === zone, z === zone)),
	);

	{
		const today = todayIn(zone, Date.now());
		const tomorrow = new Date(Date.UTC(today.year, today.month - 1, today.day + 1));
		selected = { year: tomorrow.getUTCFullYear(), month: tomorrow.getUTCMonth() + 1, day: tomorrow.getUTCDate() };
		view = { year: selected.year, month: selected.month };
	}

	const monthName = (y: number, m: number) => new Intl.DateTimeFormat("en-US", { month: "long", year: "numeric", timeZone: "UTC" }).format(Date.UTC(y, m - 1, 1));
	const dayLabel = (d: Day) => new Intl.DateTimeFormat("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric", timeZone: "UTC" }).format(Date.UTC(d.year, d.month - 1, d.day));
	const pad = (n: number) => String(n).padStart(2, "0");
	let calendarKey = "";

	function renderCalendar(now: number) {
		const today = todayIn(zone, now);
		const last = zonedParts(now + MAX_LOCK_SECONDS * 1000, zone);
		const key = `${zone}|${view.year}-${view.month}|${today.year}-${today.month}-${today.day}|${selected ? `${selected.year}-${selected.month}-${selected.day}` : ""}`;
		if (key === calendarKey) return;
		calendarKey = key;
		$("[data-month-title]").textContent = monthName(view.year, view.month);
		$<HTMLButtonElement>("[data-prev]").disabled = view.year * 12 + view.month <= today.year * 12 + today.month;
		$<HTMLButtonElement>("[data-next]").disabled = view.year * 12 + view.month >= last.year * 12 + last.month;
		daysBody.replaceChildren(
			...monthGrid(view.year, view.month).map((week) => {
				const tr = document.createElement("tr");
				for (const d of week) {
					const td = document.createElement("td");
					if (d) {
						const b = document.createElement("button");
						b.type = "button";
						b.textContent = String(d.day);
						b.setAttribute("aria-label", dayLabel(d));
						b.disabled = compareDays(d, today) < 0 || compareDays(d, last) > 0;
						if (compareDays(d, today) === 0) b.classList.add("is-today");
						b.setAttribute("aria-pressed", String(!!selected && compareDays(d, selected) === 0));
						b.addEventListener("click", () => {
							selected = d;
							render();
						});
						td.appendChild(b);
					}
					tr.appendChild(td);
				}
				return tr;
			}),
		);
	}

	function target(now: number): Target {
		return choice === "date" ? dateTarget(selected, timeInput.value, zone, now) : durationTarget(amountInput.value, unitSelect.value, now);
	}

	function render() {
		const now = Date.now();
		if (choice === "date") {
			renderCalendar(now);
			const today = todayIn(zone, now);
			const min = selected && compareDays(selected, today) === 0 ? (({ hour, minute }) => `${pad(hour)}:${pad(minute)}`)(zonedParts(now + 60_000, zone)) : "";
			if (timeInput.min !== min) timeInput.min = min;
		}
		section.querySelectorAll<HTMLButtonElement>(".chip").forEach((chip) => {
			const on = chip.dataset.choice ? chip.dataset.choice === choice : choice === "preset" && chip.dataset.unit === unitSelect.value && Number(chip.dataset.amount) === Number(amountInput.value);
			chip.setAttribute("aria-pressed", String(on));
		});
		$("#panel-duration").hidden = choice !== "custom";
		$("#panel-date").hidden = choice !== "date";
		const t = target(now);
		const error = "error" in t ? t.error : submitError;
		feedback.hidden = "error" in t;
		errorBox.hidden = !error;
		if (errorBox.textContent !== error) errorBox.textContent = error;
		if ("error" in t) return;
		const at = roundTime(roundForTime(t.ms));
		const set = (sel: string, text: string) => {
			if ($(sel).textContent !== text) $(sel).textContent = text;
		};
		set("[data-local]", formatFriendly(at, { timeZone: choice === "date" ? zone : browserZone }));
		set("[data-duration]", choice === "date" ? `, in ${formatSpan(Math.round((at - now) / 1000))}` : "");
	}

	section.querySelectorAll<HTMLButtonElement>(".chip").forEach((chip) =>
		chip.addEventListener("click", () => {
			choice = (chip.dataset.choice as typeof choice | undefined) ?? "preset";
			if (choice === "preset") {
				amountInput.value = chip.dataset.amount!;
				unitSelect.value = chip.dataset.unit!;
			}
			render();
		}),
	);
	$("[data-prev]").addEventListener("click", () => {
		view = addMonths(view.year, view.month, -1);
		render();
	});
	$("[data-next]").addEventListener("click", () => {
		view = addMonths(view.year, view.month, 1);
		render();
	});
	zoneSelect.addEventListener("change", () => {
		zone = zoneSelect.value;
		render();
	});
	$("#message").addEventListener("input", () => ($("[data-message-error]").hidden = true));
	for (const el of [amountInput, unitSelect, timeInput]) {
		el.addEventListener("input", render);
		el.addEventListener("change", render);
	}

	function renderResult() {
		const now = Date.now();
		const html = encryptedPanelHtml(lockedUntil, now);
		if (html !== resultHtml) $("[data-result-status]").innerHTML = resultHtml = html;
		const left = (lockedUntil - now) / 1000;
		const when = left > 0 ? `Opens ${formatFriendly(lockedUntil)}, in ${formatSpan(left)}.` : `Opened ${formatFriendly(lockedUntil)}.`;
		const whenBox = $("[data-share-when]");
		if (whenBox.textContent !== when) whenBox.textContent = when;
	}

	form.addEventListener("submit", async (event) => {
		event.preventDefault();
		const message = $<HTMLTextAreaElement>("#message");
		const t = target(Date.now());
		if (!message.value.trim()) {
			$("[data-message-error]").hidden = false;
			message.focus();
			return;
		}
		if ("error" in t) {
			render();
			if (choice !== "preset") (choice === "custom" ? amountInput : timeInput).focus();
			return;
		}
		const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
		button.disabled = true;
		button.textContent = "Encrypting…";
		submitError = "";
		try {
			const round = roundForTime(t.ms);
			armored = await encrypt(new TextEncoder().encode(message.value), round, client);
			lockedUntil = roundTime(round);
			noteZone = choice === "date" ? zone : browserZone;
			shareUrl = "";
			let hostError = "";
			button.textContent = "Creating link…";
			try {
				shareUrl = await createLink(armored);
			} catch (err) {
				hostError = `No share link was created. ${err instanceof Error ? err.message : String(err)} Your message is still encrypted. Copy the encrypted text below and keep it safe: we don't have a copy.`;
			}
			message.value = "";
			$("[data-share-result]").hidden = !shareUrl;
			$("[data-result-status]").hidden = !!shareUrl;
			$<HTMLInputElement>("[data-share-url]").value = shareUrl;
			$<HTMLAnchorElement>("[data-open-link]").href = shareUrl || "/";
			$("[data-open-link]").hidden = !shareUrl;
			$("[data-share-link]").hidden = !shareUrl || typeof navigator.share !== "function";
			$("[data-host-error]").textContent = hostError;
			$("[data-host-error]").hidden = !hostError;
			$<HTMLDetailsElement>("[data-cipher-details]").open = !shareUrl;
			// One primary action: the link when there is one, otherwise copying the encrypted text.
			$("[data-copy]").classList.toggle("secondary", !!shareUrl);
			form.hidden = true;
			result.hidden = false;
			renderResult();
			renderCiphertext();
			// A hosted message is recorded by the server when it stores the block; otherwise the browser reports the event.
			if (shareUrl) window.dispatchEvent(new CustomEvent(EVENT_REPORTED));
			else void reportEventOnce("encrypt", round, armored);
		} catch (err) {
			submitError = `Encryption failed: ${err instanceof Error ? err.message : String(err)}`;
			render();
		} finally {
			button.disabled = false;
			button.textContent = "Encrypt";
		}
	});

	const notesBox = $<HTMLInputElement>("[data-notes]");
	/** Exactly what Copy, Download and Decrypt get: the block, with the plain notes above it when the box is ticked. */
	const ciphertext = () => withNotes(armored, notesBox.checked ? noteLines(lockedUntil, { instructions: true, unlockTime: true, timeZone: noteZone }) : []);
	const renderCiphertext = () => ($<HTMLTextAreaElement>("#ciphertext").value = ciphertext());
	notesBox.addEventListener("change", renderCiphertext);

	async function copyWithFeedback(button: HTMLButtonElement, text: string) {
		await navigator.clipboard.writeText(text);
		const label = button.textContent;
		button.textContent = "Copied";
		setTimeout(() => (button.textContent = label), 1500);
	}
	$("[data-copy]").addEventListener("click", (e) => copyWithFeedback(e.currentTarget as HTMLButtonElement, ciphertext()));
	$("[data-download]").addEventListener("click", () => {
		const a = document.createElement("a");
		a.href = URL.createObjectURL(new Blob([ciphertext()], { type: "text/plain" }));
		a.download = `timelock-${new Date(lockedUntil).toISOString().replace(/[:.]/g, "-")}.age`;
		a.click();
		URL.revokeObjectURL(a.href);
	});
	$("[data-to-decrypt]").addEventListener("click", () => {
		handOffToDecrypt(ciphertext());
	});
	$("[data-copy-link]").addEventListener("click", (e) => copyWithFeedback(e.currentTarget as HTMLButtonElement, shareUrl));
	$<HTMLInputElement>("[data-share-url]").addEventListener("focus", (e) => (e.currentTarget as HTMLInputElement).select());
	$("[data-share-link]").addEventListener("click", () => {
		navigator.share({ title: "timelock.dev", text: `A message locked until ${formatFriendly(lockedUntil)}.`, url: shareUrl }).catch(() => {});
	});
	$("[data-again]").addEventListener("click", () => {
		result.hidden = true;
		form.hidden = false;
		lockedUntil = 0;
		$<HTMLTextAreaElement>("#message").focus();
	});

	render();
	setInterval(() => {
		if (!form.hidden) render();
		if (lockedUntil) renderResult();
	}, 1000);
</script>
